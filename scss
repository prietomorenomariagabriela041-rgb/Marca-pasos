* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #0b1117;
    color: #edf5f7;
}

.container {
    max-width: 1200px;
    margin: auto;
    padding: 35px 20px;
}


/* ENCABEZADO */

header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 25px;
}

.eyebrow {
    color: #65d6c4;
    font-size: 12px;
    letter-spacing: 1.5px;
    font-weight: bold;
}

h1 {
    margin: 6px 0;
    font-size: 34px;
}

.subtitle {
    color: #9eabb3;
    margin-top: 8px;
}

.status {
    background: #12362f;
    color: #68e0c5;
    padding: 10px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
    white-space: nowrap;
}


/* DISTRIBUCIÓN */

.grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

.lower {
    margin-top: 20px;
    grid-template-columns: 1fr 1fr;
}


/* TARJETAS */

.card {
    background: #111a22;
    border: 1px solid #24323b;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,.18);
}

.card-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

h2 {
    font-size: 18px;
    margin: 0 0 18px;
}

#modeBadge {
    background: #20323a;
    color: #8de8d7;
    padding: 6px 10px;
    border-radius: 10px;
    font-size: 12px;
}


/* ECG */

canvas {
    width: 100%;
    height: 300px;
    background: #081015;
    border-radius: 10px;
    border: 1px solid #1d3038;
}


/* MÉTRICAS */

.metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 14px;
}

.metrics div,
.device div {
    background: #0c141a;
    padding: 14px;
    border-radius: 10px;
}

.metrics span,
.device span {
    color: #7f9099;
    font-size: 12px;
    display: block;
}

.metrics strong {
    font-size: 22px;
    margin-top: 5px;
    display: block;
}

.metrics small {
    font-size: 11px;
    color: #7f9099;
}


/* CONTROLES */

.controls label {
    display: block;
    margin: 16px 0;
    color: #b7c3c9;
    font-size: 13px;
}

.controls b {
    float: right;
    color: white;
}

select,
input {
    width: 100%;
    margin-top: 9px;
}

select {
    padding: 11px;
    border-radius: 8px;
    background: #0b141a;
    color: white;
    border: 1px solid #31434c;
}

input[type="range"] {
    accent-color: #65d6c4;
}


/* BOTONES */

button {
    width: 100%;
    border: 0;
    padding: 13px;
    border-radius: 9px;
    background: #65d6c4;
    color: #07110f;
    font-weight: bold;
    cursor: pointer;
    margin-top: 8px;
}

button:hover {
    opacity: .85;
}

button.secondary {
    background: #26343d;
    color: #dce7eb;
}


/* ESTADO */

.device {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.device strong {
    display: block;
    margin-top: 5px;
}


/* AVISO */

.note {
    margin-top: 15px;
    padding: 12px;
    border-left: 3px solid #d8b85a;
    background: #1b1910;
    color: #c9bd92;
    font-size: 12px;
    line-height: 1.5;
}


/* RESPONSIVE */

@media(max-width: 800px) {

    header {
        display: block;
    }

    .grid,
    .lower {
        display: block;
    }

    .card {
        margin-bottom: 18px;
    }

    .metrics {
        grid-template-columns: 1fr;
    }

    .device {
        grid-template-columns: 1fr;
    }

    .status {
        display: inline-block;
        margin-top: 15px;
    }
}
